# ─────────────────────────────────────────────────────────────────────────────
# Projet Action — Variables d'environnement V4 v2
# cp .env.example .env  puis renseigner les valeurs manquantes.
# Ne jamais commiter .env
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=projet_action
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postges
# URL complète (surcharge les variables individuelles ci-dessus)
# DATABASE_URL=postgresql://postgres:changeme@db:5432/projet_action

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://cache:6379/0

# ── FastAPI ───────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_with_a_random_32_byte_hex_string

# ── Ports exposés (defaults dans docker-compose.yml) ─────────────────────────
API_PORT=8000
WEB_PORT=3000
ADMINER_PORT=8080
PROXY_HTTP_PORT=80

# ── Frontend Next.js ──────────────────────────────────────────────────────────
# Vide = URL relative (single-origin via nginx). Ne jamais mettre :8000 ici.
NEXT_PUBLIC_API_URL=
# Server-side (proxy.ts middleware) — DNS Docker, jamais exposé au browser.
INTERNAL_API_URL=http://api:8000

# ── CORS (FastAPI) ───────────────────────────────────────────────────────────
# CSV des origines autorisées. Single-origin via nginx → http://localhost.
CORS_ORIGINS=http://localhost

# ── Emails transactionnels (Resend) ──────────────────────────────────────────
# Créer un compte sur https://resend.com et vérifier le domaine expéditeur.
# En dev, APP_ENV=development → les emails sont loggués (pas envoyés).
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=STOX <noreply@stox.fr>
EMAIL_REPLY_TO=support@stox.fr

# ── Frontend (pour les liens dans les emails) ─────────────────────────────────
FRONTEND_URL=http://localhost

# ── CRON / Purge RGPD ────────────────────────────────────────────────────────
# Secret pour l'endpoint POST /api/v1/internal/purge (Vercel Cron / GitHub Actions)
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=change_me_with_a_random_32_byte_hex_string
