# ─────────────────────────────────────────────────────────────────────────────
# Projet Action — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs manquantes.
# Ne jamais commiter le fichier .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── API externe : Financial Modeling Prep ─────────────────────────────────────
# Clé gratuite ou payante sur https://financialmodelingprep.com/
# Requise uniquement si le fallback FMP est activé (fmp_client.py).
FMP_API_KEY=your_fmp_api_key_here

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Mot de passe obligatoire (pas de valeur par défaut en prod).
POSTGRES_DB=projet_action
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production

# ── Redis ─────────────────────────────────────────────────────────────────────
# Utilisé pour le cache distribué des données yfinance / FMP.
# Optionnel en dev si REDIS_URL est laissé vide (cache fichier local utilisé).
REDIS_URL=redis://cache:6379/0

# ── Ports exposés (optionnel — defaults dans docker-compose.yml) ──────────────
API_PORT=8000
ADMINER_PORT=8080

# ── FastAPI ───────────────────────────────────────────────────────────────────
# Passé à uvicorn ; ajuster si besoin.
APP_ENV=development
LOG_LEVEL=info

# ── Emails transactionnels (frontend Next.js — via Resend) ───────────────────
# Créer un compte sur https://resend.com et vérifier le domaine expéditeur.
# Copier ces variables dans frontend/.env.local
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=AnalysePro <noreply@analysepro.fr>

# ── Supabase Auth (frontend Next.js) ─────────────────────────────────────────
# Projet créé en région Frankfurt EU (Free plan) — conformité RGPD
# Dashboard > Settings > API pour récupérer les valeurs ci-dessous.
# Dashboard > Settings > Auth > URL Configuration :
#   Site URL : https://votre-domaine.com
#   Redirect URLs : https://votre-domaine.com/api/auth/callback
# Dashboard > Settings > Auth > SMTP (optionnel) :
#   Configurer Resend SMTP pour que les emails Supabase (vérification, reset)
#   utilisent le même expéditeur que les emails transactionnels.
#   Host : smtp.resend.com · Port : 465 · User : resend · Pass : RESEND_API_KEY
# Copier ces variables dans frontend/.env.local
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
# SECRETE — ne jamais exposer côté client (pas de NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
SUPABASE_PROJECT_REF=<project-ref>

# ── Upstash Redis (rate limiting — frontend Next.js) ──────────────────────────
# Créer une DB sur https://console.upstash.com · région EU-West-1 · plan Free
# Copier ces variables dans frontend/.env.local
UPSTASH_REDIS_REST_URL=https://<redis-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-redis-token>
